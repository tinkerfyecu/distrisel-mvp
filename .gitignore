*.p12
*.pfx

# Local harness state, ownership databases, caches and execution history.
# Keep the portable health/Windows compatibility scripts available to collaborators.
.harness/*
!.harness/scripts/

# Configuration backups can contain old secrets or private paths
*.bak
*.backup
*.backup-*

# Keep .mcp.json, .claude/agents, .claude/skills, AGENTS.md and docs tracked:
# the reviewed shared configuration/instructions contain no detected credentials.
